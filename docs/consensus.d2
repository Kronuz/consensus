# consensus: a deterministic Raft core, its Worker, and the pieces around it.
# Render: d2 --layout elk --sketch --theme 302 docs/consensus.d2 docs/consensus.svg
vars: { d2-config: { layout-engine: elk; theme-id: 302; sketch: true; pad: 24 } }
direction: down

host: "host\nticks · proposals · reads"

worker: Worker {
  label: "Worker: admission · persistence · checkpoints"
  style.font-size: 20
  core: "Core\ndeterministic Raft\nno I/O, no clock"
}

journal: "journal\nper-group or shared turn log"
channel: "SnapshotChannel\nwindowed chunks"
transport: "transport (optional)\nTLS to the other voters"

host <-> worker
worker -> journal
worker -> channel
worker -> transport
